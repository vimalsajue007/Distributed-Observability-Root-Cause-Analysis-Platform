# One image recipe for every Python service:
#   docker build -f docker/Dockerfile.service --build-arg SERVICE=trace-service --build-arg PACKAGE=trace_service .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app --no-create-home app
WORKDIR /app

COPY requirements/runtime.txt /tmp/runtime.txt
RUN pip install -r /tmp/runtime.txt && rm /tmp/runtime.txt

COPY libs/obs_common /tmp/obs_common
RUN pip install --no-deps /tmp/obs_common && rm -rf /tmp/obs_common

ARG SERVICE
ARG PACKAGE
ENV PACKAGE=${PACKAGE}
COPY services/${SERVICE}/ /app/
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod 0555 /entrypoint.sh && chown -R app:app /app

USER app
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=4s --start-period=25s --retries=6 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"
ENTRYPOINT ["/entrypoint.sh"]
