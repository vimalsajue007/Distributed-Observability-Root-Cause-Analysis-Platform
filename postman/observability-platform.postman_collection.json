              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('502 from payment-service', () => { pm.response.to.have.status(502); const e = pm.response.json().error; pm.expect(e.source).to.eql('downstream'); pm.expect(e.service).to.eql('payment-service'); });"
                ]
