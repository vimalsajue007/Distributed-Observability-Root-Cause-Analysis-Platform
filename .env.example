# =====================================================================================
# Observability platform - environment template.   cp .env.example .env   then change EVERY secret.
# The values below are for local development only. Never commit a real .env.
# =====================================================================================

# ---- MySQL (one database + one user per service; the init script creates them) --------
MYSQL_ROOT_PASSWORD=change-me-root-3f9a
INGESTION_DB_PASSWORD=change-me-ingestion-1a
TRACE_DB_PASSWORD=change-me-trace-2b
LOG_DB_PASSWORD=change-me-log-3c
METRICS_DB_PASSWORD=change-me-metrics-4d
RCA_DB_PASSWORD=change-me-rca-5e
GATEWAY_DB_PASSWORD=change-me-gateway-6f
ORDER_DB_PASSWORD=change-me-order-7a
PAYMENT_DB_PASSWORD=change-me-payment-8b
NOTIFICATION_DB_PASSWORD=change-me-notification-9c

# ---- RabbitMQ ---------------------------------------------------------------------------
RABBITMQ_USER=obs
RABBITMQ_PASSWORD=change-me-rabbit-4g

# ---- Service-to-service trust ------------------------------------------------------------
# Sent as X-Internal-Token between services. Generate: openssl rand -hex 32
INTERNAL_API_TOKEN=change-me-internal-token-0123456789abcdef0123456789abcdef
# Telemetry producers authenticate to the ingestion service with X-API-Key (comma separated list = key rotation).
INGEST_API_KEYS=change-me-ingest-key-aaaaaaaaaaaaaaaaaaaaaaaa
# Key used by the sample services and the gateway when shipping telemetry (must be one of INGEST_API_KEYS).
INGESTION_API_KEY=change-me-ingest-key-aaaaaaaaaaaaaaaaaaaaaaaa

# ---- Console authentication (API gateway) -----------------------------------------------
# JWT signing secret, >= 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-0123456789abcdef0123456789abcdef
JWT_TTL_SECONDS=3600
# Initial passwords of the seeded users admin / operator / viewer (stored as PBKDF2 hashes).
SEED_ADMIN_PASSWORD=Admin#2026-change-me
SEED_OPERATOR_PASSWORD=Operator#2026-change-me
SEED_VIEWER_PASSWORD=Viewer#2026-change-me

# ---- Behaviour ---------------------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
ENABLE_DOCS=true
# Failure scenario used when a request has no X-Scenario header (normal | slow_payment | payment_failure | payment_timeout |
# notification_timeout | invalid_downstream_response | intermittent_unavailability)
DEFAULT_SCENARIO=normal
# Trace completion: a trace is finalised after this many quiet seconds without a new span.
TRACE_COMPLETION_WAIT_SECONDS=10
# A span slower than this is flagged as slow (also compared with its own historical baseline).
SLOW_SPAN_MS=1000

# ---- Published host ports ------------------------------------------------------------------
CONSOLE_PORT=3000
GATEWAY_PORT=8000
RABBITMQ_MANAGEMENT_PORT=15672
